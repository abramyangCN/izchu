# Strava application created at https://www.strava.com/settings/api
IZCHU_STRAVA_CLIENT_ID=286135
IZCHU_STRAVA_CLIENT_SECRET=
IZCHU_STRAVA_REDIRECT_URI=http://localhost:8080/api/strava/callback

# Leave these empty after the first Garmin login. izchu stores renewable
# Garmin tokens under IZCHU_DATA_DIR and does not need the password afterward.
IZCHU_GARMIN_EMAIL=
IZCHU_GARMIN_PASSWORD=

IZCHU_DATA_DIR=/data
IZCHU_LOG_LEVEL=INFO

